POSTGRES_USER=alphractal
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fees_monitor
DATABASE_URL=postgresql://alphractal:changeme@db:5432/fees_monitor

# Provedor RPC. O padrão é um endpoint público sem chave, suficiente para
# desenvolvimento. Para produção/backfill longo, trocar por Alchemy ou Infura
# (rate limit e histórico retroativo do plano público são limitados).
RPC_HTTP_URL=https://ethereum-rpc.publicnode.com
RPC_WS_URL=wss://ethereum-rpc.publicnode.com

# false desliga a ingestão ao vivo (útil para rodar só o backfill)
INGESTAO_ATIVA=true
